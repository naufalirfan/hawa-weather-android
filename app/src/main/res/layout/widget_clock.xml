<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="top|start">

    <!-- Date (e.g. Sab, 28 Nov) -->
    <TextClock
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEE, d MMM"
        android:format24Hour="EEE, d MMM"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:includeFontPadding="false" />

    <!-- Weather info (e.g. Umumnya berawan ☁ 32°) -->
    <TextView
        android:id="@+id/weather_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:text="Memuat... 🌤️"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:includeFontPadding="false" />

    <!-- Stacked Hours & Minutes -->
    <LinearLayout
        android:id="@+id/clock_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <!-- Hour (e.g. 12) -->
        <TextClock
            android:id="@+id/clock_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h"
            android:format24Hour="H"
            android:textColor="#FFFFFF"
            android:textSize="68sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="10"
            android:includeFontPadding="false" />

        <!-- Minute (e.g. 49) -->
        <TextClock
            android:id="@+id/clock_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:textColor="#FFFFFF"
            android:textSize="68sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="10"
            android:includeFontPadding="false" />
    </LinearLayout>

</LinearLayout>
